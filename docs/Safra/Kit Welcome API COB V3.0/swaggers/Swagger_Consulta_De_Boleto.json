  "paths": {
    "/consultarBoleto": {
      "get": {
        "tags": [
          "ConsultaBoleto"
        ],
        "parameters": [
          {
            "name": "Safra-Correlation-ID",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "Authorization",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agencia",
            "in": "query",
            "required": true,
            "schema": {
              "maximum": 99999,
              "minimum": 0,
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "conta",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^\\d\\d{1,9}$",
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "numeroDoBoleto",
            "in": "query",
            "required": true,
            "schema": {
              "pattern": "^\\d{1,15}$",
              "type": "string"
            }
          },
          {
            "name": "seuNumero",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaBoletoSaidaSingleResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaBoletoSaidaSingleResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConsultaBoletoSaidaSingleResponse"
                }
              }
            }
          }
        }
      }
    }
