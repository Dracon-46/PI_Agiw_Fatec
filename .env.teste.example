# ===========================================
# Conciliação Bancária - .env da BASE DE TESTE
#
# Copie para ".env" para rodar o módulo localmente, sem a base do ERP:
#   cp .env.teste.example .env
#   npm run db:teste
#   npm run dev
#
# As credenciais dos bancos abaixo são FICTÍCIAS: servem apenas para as
# contas do Itaú e do Safra aparecerem como integradas. O extrato de
# outubro/2026 já vem gravado na base de teste, então nenhuma API é chamada
# dentro do período abaixo.
# ===========================================

# SQL Server local (por exemplo, o contêiner do passo a passo do README)
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=BDCONCILIACAO_TESTE
DB_USER=sa
DB_PASS=Teste@12345
DB_INSTANCE=
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
DATABASE_URL="sqlserver://localhost:1433;database=BDCONCILIACAO_TESTE;user=sa;password=Teste@12345;encrypt=true;trustServerCertificate=true;"

# Chaves do ERP
CODEMP=01
CONB_CODDOCUM_TRANSFERENCIA=TED
ERP_SISTEMA_ID=CONB
USUARIO_ATUAL=TESTE

# Período em que a base de teste tem extrato gravado
NEXT_PUBLIC_PERIODO_INICIO=01/10/2026
NEXT_PUBLIC_PERIODO_FIM=31/10/2026
BANK_FILTRA_PERIODO=true

# Provider padrão
BANK_PROVIDER=itau

# Itaú (fictício)
ITAU_AMBIENTE=sandbox
ITAU_SANDBOX_URL=https://sandbox.devportal.itau.com.br/itau-ep9-api-extrato-v1-externo/v1
ITAU_BASE_URL=https://boleto.api.itau.com/extrato/v1
ITAU_CLIENT_ID=teste
ITAU_CLIENT_SECRET=teste

# Safra (fictício)
SAFRA_API_URL=https://api-hml.safranegocios.com.br
SAFRA_CLIENT_ID=teste
SAFRA_USERNAME=teste
SAFRA_PASSWORD=teste
