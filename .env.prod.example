# ===========================================
# Ambiente de produção (conta AWS real)
# Não usar no lab. Em produção as senhas viriam do Secrets Manager.
# ===========================================

NODE_ENV=production

# RDS MySQL (não o container)
MYSQL_HOST=conciliacao-db.xxxxxxxx.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=admin
MYSQL_PASSWORD=
MYSQL_DATABASE=conciliacao_agiw

BANK_PROVIDER=bradesco

BRADESCO_CLIENT_ID=
BRADESCO_CLIENT_SECRET=
BRADESCO_CERT_PATH=/app/certs/certificado.crt
BRADESCO_KEY_PATH=/app/certs/chave.key
BRADESCO_BASE_URL=https://openapi.bradesco.com.br
BRADESCO_API_URL=

SAFRA_API_URL=https://api.safranegocios.com.br
SAFRA_CLIENT_ID=
SAFRA_USERNAME=
SAFRA_PASSWORD=
SAFRA_EXTRATO_PATH=/gateway/contacorrente/v1/extrato
