// Schema Prisma gerado a partir do dicionário de dados real do sistema
// ("Tabelas do sistema.txt" — saída de `prisma db pull` do banco SQL Server).
//
// Contém apenas as 14 tabelas solicitadas. Os campos, tipos, defaults e nomes
// de constraint (map: "...") foram mantidos exatamente como no dicionário original.
// Relacionamentos (@relation) foram mantidos SOMENTE entre tabelas presentes
// neste subconjunto — relações para tabelas fora da lista (ex.: TBGENE009,
// TBGENE032, TBFATU016, etc.) foram removidas porque essas tabelas não
// fazem parte deste schema. As colunas FK correspondentes continuam
// presentes como campos escalares comuns.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  schemas  = ["dbo"]
}

