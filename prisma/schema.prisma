  ALTSENPROXLOG             String?   @db.Char(1)
  EMAIL                     String?   @db.Char(70)
  FONE                      String?   @db.Char(12)
  FAX                       String?   @db.Char(12)
  DEPARTAMENTO              String?   @db.Char(30)
  STARECEMAILRESERVAPARCIAL String?   @default("N", map: "DF__TBSENH006__STARE__1C238250") @db.Char(1)
  STARECEMAILSINF           String?   @default("N", map: "DF__TBSENH006__STARE__4C09364A") @db.Char(1)
  CODGRUPOCOM               String?   @db.VarChar(4)
  AREALIBPEDVENDA           String?   @db.Char(1)
  CODGRCOMPRA               String?   @db.Char(2)
  ASSINATURA                String?   @db.Char(100)
  FUNCAO                    String?   @db.Char(50)
  GESTORAPROVSC             String?   @default("S", map: "DF__TBSENH006__GESTO__654487C9") @db.Char(1)
  RAMAL                     String?   @db.Char(3)
  CPFUSUARIO                String?   @db.Char(14)
  RGUSUARIO                 String?   @db.Char(12)
  NUMIDENT                  String?   @db.Char(25)
  STAENVIAEMAIL             String?   @default("N", map: "DF__TBSENH006__STAEN__433B1F36") @db.Char(1)
  DATULTLOGIN               DateTime? @db.DateTime
  APPULTLOGIN               String?   @db.VarChar(20)
  HOSTULTLOGIN              String?   @db.VarChar(30)
  LINKEXTERNO               String?   @db.VarChar(250)
  EMAILPOWERBI              String?   @db.VarChar(250)
  SENHAPOWERBI              String?   @db.VarChar(50)

  @@schema("dbo")
}

// ============================================================================
// Tabelas NOVAS do módulo (Ticket 37060).
//
// São as duas únicas coisas que o ERP não tem, porque nascem da leitura do
// extrato por API — o ERP importava arquivo (TBCONB006.NOMEARQUIVO). Os nomes
// seguem o padrão TBXXXX999 da Agiw, na sequência do módulo de conciliação
// bancária (TBCONB001 a TBCONB007 já existem), e as colunas usam os prefixos
// do padrão: COD código, DES descrição, DAT data, VAL valor, NUM número,
// TIP tipo, STA situação.
//
// O DDL destas duas tabelas está em database/schema.sql e é aplicado por
// `npm run db:init`. NUNCA use `prisma db push` nem `prisma migrate` contra o
// BDAPRESENTACAO: este arquivo descreve um subconjunto do banco, e o Prisma
// trataria as outras ~1290 tabelas do ERP como sobra a ser removida.
// ============================================================================

/// TBCONB008 - Dias de Extrato Consultados na API
/// Sem este registro não haveria como distinguir "dia sem movimento" de "dia
/// nunca consultado": os dois chegam da API como lista vazia, e o sistema
/// repetiria a mesma consulta para sempre. A conta é identificada como em
/// TBCONB006 (empresa + banco + agência + conta corrente).
model TBCONB008 {
  CODEMP         String   @db.Char(2)
  CODBANCO       String   @db.Char(6)
  CODAGENCIA     String   @db.Char(10)
  CODCTACORRENTE String   @db.Char(15)
  DATEXTRATO     DateTime @db.DateTime
  DATCONSULTA    DateTime @db.DateTime
  QTDMOVTO       Int?
  NOMPROVIDER    String?  @db.Char(20)

  @@id([CODEMP, CODBANCO, CODAGENCIA, CODCTACORRENTE, DATEXTRATO], map: "PKTBCONB008")
  @@schema("dbo")
}

/// TBCONB009 - Auditoria da Conciliação Bancária
/// Atende o item 6.5 das sugestões: registro de quem conciliou, quem bloqueou
/// período, quem lançou ou excluiu. A chave é IDENTITY, e não uma sequência em
/// CHAR como no resto do módulo, porque a trilha é gravada em concorrência —
/// montar a sequência no cliente exigiria travar a tabela a cada evento.
model TBCONB009 {
  NUMSEQAUDIT    BigInt   @id(map: "PKTBCONB009") @default(autoincrement())
  CODEMP         String   @db.Char(2)
  DATEVENTO      DateTime @db.DateTime
  USER_ID        String   @db.Char(10)
  TIPACAO        String   @db.Char(20)
  DESENTIDADE    String   @db.Char(20)
  CODENTIDADE    String?  @db.VarChar(120)
  DESDETALHE     String   @db.VarChar(600)
  VALREFERENCIA  Decimal? @db.Decimal(28, 14)
  CODBANCO       String?  @db.Char(6)
  CODAGENCIA     String?  @db.Char(10)
  CODCTACORRENTE String?  @db.Char(15)

  @@index([CODEMP, DATEVENTO], map: "INDTBCONB009_DATEVENTO")
  @@index([TIPACAO, DATEVENTO], map: "INDTBCONB009_TIPACAO")
  @@schema("dbo")
}
