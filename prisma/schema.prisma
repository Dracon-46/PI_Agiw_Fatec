  STALIBTODAREA             String?   @default("S", map: "DF__TBSENH006__STALI__5F09F7B7") @db.Char(1)
  STALIBERAPEDVENDA         String?   @default("S", map: "DF__TBSENH006__STALI__5FFE1BF0") @db.Char(1)
  CCUSTO                    String?   @db.Char(10)
  PROCATU                   String?   @default("A", map: "DF__TBSENH006__PROCA__60F24029") @db.Char(1)
