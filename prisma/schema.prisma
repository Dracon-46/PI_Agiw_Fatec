  CONTACHEQUE       String?     @db.Char(20)
  SEQMOVTOCONB      String      @default("001", map: "DF__TBCONB001__SEQMO__36BDA5E9") @db.Char(3)
  SEQMOVTOCONBRELAC String?     @db.Char(3)
  /// CALCULADA pelo servidor: case TIPOMOVTO when 'S' then -1 else 1 end.
  /// Serve para somar (SUM(VALMOVTO * SINAL)) e NUNCA pode ser gravada — o
  /// SQL Server recusa a instrucao que a inclui no INSERT ou no UPDATE.
  /// Declarada OPCIONAL por isso: no banco ela e NOT NULL, mas exigi-la aqui
  /// obrigaria todo create a informar um valor que o servidor nao aceita.
  SINAL             Int?

  TBCONB003         TBCONB003[]

  @@id([CODEMP, CODDOCUM, NUMDOCTO, SERIE, CODEMITENTE, DESDOBRO, NUMSEQPAGTO, SEQMOVTOCONB], map: "PKTBCONB001")
  @@index([CODEMP, CODBANCO, CODAGENCIA, NUMCTACORRENTE, DATSALDO], map: "INDTBCONB001_CODBANCO")
  @@index([CODEMP, CODBANCO, CODAGENCIA, NUMCTACORRENTE, DATBAIXA], map: "INDTBCONB001_CODBANCO_DATBAIXA")
  @@index([CODEMP, CODBANCO, CODAGENCIA, NUMCTACORRENTE, DATBAIXA, DATMOVTO], map: "INDTBCONB001_CODBANCO_DATBAIXA_DATMOVTO")
  @@index([CODEMP, CODBANCO, CODAGENCIA, NUMCTACORRENTE, DATMOVTO], map: "INDTBCONB001_CODBANCO_DATMOVTO")
  @@index([DATBAIXA], map: "INDTBCONB001_DATBAIXA")
  @@index([ORIGEMMOVTO, CODDOCUM, SERIE, DESDOBRO, NUMSEQPAGTO, CODEMITENTE, NUMDOCTO, SEQMOVTOCONB, CODEMP], map: "INDTBCONB001_GFN_001")
  @@index([DATMOVTO, CODDOCUM, SERIE, DESDOBRO, NUMSEQPAGTO, CODEMITENTE, ORIGEMMOVTO, CODEMP, SEQMOVTOCONB, NUMDOCTO, DATBAIXA], map: "INDTBCONB001_GFN_002")
  @@schema("dbo")
}

