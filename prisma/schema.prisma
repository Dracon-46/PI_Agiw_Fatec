  TBGENE023             TBGENE023?  @relation(fields: [CODEMP, CONTLABOUR], references: [CODEMP, CONTESTO], onUpdate: NoAction, map: "FKTBCOMP008_TBGENE023_01")

  @@id([CODEMP, CCUSTO], map: "PKTBCOMP008")
  @@index([CODEMP, CODALMOX], map: "INDTBCOMP008_CODALMOX")
  @@schema("dbo")
}

