/// TBGENE009 - Tipos de Documento
/// Alimenta a caixa "Novo Lançamento" (item 6.1.3.8 — ação 1); é o CODDOCUM
/// que TBCONB001 exige na chave.
model TBGENE009 {
  CODDOCUM             String    @id(map: "PK") @db.Char(3)
  DESDOCUM             String    @db.Char(50)
  DATATU               DateTime  @db.DateTime
  STADOCUM             String    @db.Char(1)
  STAUSODOSISTEMA      String    @db.Char(1)
  STANOTADEBCRED       String?   @default("N", map: "DF__TBGENE009__STANO__33408412") @db.Char(1)
  CODGRUPODOCTO        String?   @db.Char(3)
  CODREGFISCAL         String?   @db.Char(5)
  CODDOCTOICMS         String?   @db.Char(2)
  CODDOCTOISS          String?   @db.Char(2)
  STAGERANUMERO        String?   @db.Char(1)
  DOCLANCAIPI          String?   @default("S", map: "DF__TBGENE009__DOCLA__4F1F3F5F") @db.Char(1)
  CODEVENTO_ENTR_CP    String?   @db.Char(5)
  CODEVENTO_ENTR_CR    String?   @db.Char(5)
  CODEVENTO_VARCAMB_CP String?   @db.Char(5)
  CODEVENTO_VARCAMB_CR String?   @db.Char(5)
  STAVARCAMBRC         String?   @default("S", map: "DF__TBGENE009__STAVA__5F56A449") @db.Char(1)

  @@index([CODDOCUM, CODDOCTOICMS], map: "INDTBGENE009_CODDOCTOICMS")
  @@index([CODDOCTOICMS], map: "INDTBGENE009_CODDOCTOICMS2")
  @@schema("dbo")
}

/// TBSENH005 - Permissão do Usuário por Módulo
/// É contra esta tabela que o item 6.1.3.1 ("verificar permissão de acesso")
/// é conferido: ALTERACAO libera bloquear/desbloquear o período, INCLUSAO
/// libera lançar, EXCLUSAO libera excluir.
model TBSENH005 {
  SISTEMA_ID   String  @db.Char(10)
  CODEMP       String  @default("01", map: "DF__TBSENH005__CODEM__5A45429A") @db.Char(2)
  USER_ID      String  @db.Char(10)
  MODULO_ID    String  @db.Char(10)
  INCLUSAO     String  @db.Char(1)
  ALTERACAO    String  @db.Char(1)
  CONSULTA     String  @db.Char(1)
  EXCLUSAO     String  @db.Char(1)
  IMPRESSAO    String  @db.Char(1)
  TIPO         String  @db.Char(1)
  CODMENU      String  @db.Char(5)
  PROCATU      String? @default("A", map: "DF__TBSENH005__PROCA__5B3966D3") @db.Char(1)
  INCLUSAOTMP  String? @default("N", map: "DF_TBSENH005_INCLUSAOTMP") @db.Char(1)
  ALTERACAOTMP String? @default("N", map: "DF_TBSENH005_ALTERACAOTMP") @db.Char(1)
  CONSULTATMP  String? @default("N", map: "DF_TBSENH005_CONSULTATMP") @db.Char(1)
  IMPRESSAOTMP String? @default("N", map: "DF_TBSENH005_IMPRESSAOTMP") @db.Char(1)
  EXCLUSAOTMP  String? @default("N", map: "DF_TBSENH005_EXCLUSAOTMP") @db.Char(1)
  STAAPROVACAO String? @db.Char(1)
  USER_ID_ADM1 String? @db.Char(10)
  USER_ID_ADM2 String? @db.Char(10)

  @@id([SISTEMA_ID, CODEMP, USER_ID, MODULO_ID], map: "PKTBSENH005")
  @@index([CODMENU], map: "INDTBSENH005_CODMENU")
  @@index([CODEMP, MODULO_ID, USER_ID, ALTERACAO], map: "INDTBSENH005_MODULO_ID")
  @@index([SISTEMA_ID, MODULO_ID], map: "INDTBSENH005_SISTEMAID_MODULO_ID")
  @@index([SISTEMA_ID, USER_ID, MODULO_ID], map: "INDTBSENH005_SISTEMAID_USERID")
  @@index([USER_ID, TIPO, MODULO_ID], map: "INDTBSENH005_USER_ID")
  @@schema("dbo")
}

