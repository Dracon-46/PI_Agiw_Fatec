  CODFILIALBANCO    String?     @db.Char(2)
  STAINTEGRACONT    String?     @db.Char(1)
  ANOLOTECONTAB     String?     @db.Char(4)
  MESLOTECONTAB     String?     @db.Char(2)
  NUMLOTECONTAB     String?     @db.Char(7)
  SUBGRUPO          String?     @db.Char(12)
  CATEGORIA         String?     @db.Char(1)
  CODGRUPO          String?     @db.Char(6)
  STAGERARTITREC    String?     @default("N", map: "DF__TBCONB001__STAGE__1D4655FB") @db.Char(1)
  STAMOVTO          String?     @db.Char(1)
  NUMSEQCONC        String?     @db.Char(6)
