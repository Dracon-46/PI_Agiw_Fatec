# ===========================================
# Ambiente AWS Academy (lab)
# Copie para ".env" NA EC2. Nunca versionar o .env preenchido.
# ===========================================

NODE_ENV=production

# Dentro do docker compose o host do banco é o nome do serviço
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=troque-esta-senha-no-servidor
MYSQL_DATABASE=conciliacao_agiw

BANK_PROVIDER=bradesco

# Credenciais bancárias só no servidor — deixe vazio se for só demo/arquivo
BRADESCO_CLIENT_ID=
BRADESCO_CLIENT_SECRET=
BRADESCO_CERT_PATH=certs/certificado.crt
BRADESCO_KEY_PATH=certs/chave.key
BRADESCO_BASE_URL=https://openapisandbox.prebanco.com.br
BRADESCO_API_URL=https://openapisandbox.prebanco.com.br/v1/fornecimento-extratos-contas

SAFRA_API_URL=https://api-hml.safranegocios.com.br
SAFRA_CLIENT_ID=
SAFRA_USERNAME=
SAFRA_PASSWORD=
SAFRA_EXTRATO_PATH=/gateway/contacorrente/v1/extrato

NEXT_PUBLIC_PERIODO_INICIO=06/11/2024
NEXT_PUBLIC_PERIODO_FIM=20/11/2024
