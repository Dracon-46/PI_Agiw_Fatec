{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": ["node_modules/", ".next/", "coverage/"],
  "rules": {
    "no-var": "error",
    "prefer-const": "error",
    "eqeqeq": ["error", "always", { "null": "ignore" }],
    "no-unused-vars": ["error", { "args": "none", "ignoreRestSiblings": true }]
  }
}
