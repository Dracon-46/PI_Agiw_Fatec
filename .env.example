# ===========================================
# Conciliação Bancária - Variáveis de Ambiente
# Projeto Banco - Ticket 37060 | Agiw Sistemas
#
# Copie para ".env" e preencha. O .env NÃO é versionado.
# ===========================================

# Provider padrão ao iniciar a aplicação (bradesco | itau | bb | safra)
BANK_PROVIDER=bradesco

# -------------------------------------------
# MYSQL / MariaDB (contas, extrato importado, lançamentos)
# No XAMPP o padrão é root sem senha.
# Crie a estrutura com: npm run db:init
# -------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=conciliacao_agiw

# -------------------------------------------
# BRADESCO
#
# IMPORTANTE: a API exige mTLS (certificado de cliente). O endpoint de token
# responde 401 "SSL with client authentication is required" sem o certificado,
# e todos os outros caminhos de token retornam 404. Baixe o certificado no
# portal do desenvolvedor e informe os caminhos do .crt e do .key abaixo.
#
# O APP_KEY (gw-dev-app-key) NÃO é necessário para autenticar no sandbox.
#
# Agência: máx. 5 dígitos | Conta: máx. 13 dígitos | tipo: cc|cp
# Datas enviadas à API no formato DDMMAAAA (a conversão é automática).
#
# Sandbox: o ambiente é um mock e responde apenas a combinações previamente
# cadastradas. A combinação conhecida que retorna extrato é:
#   agência 3750 / conta 75557 / período 06/11/2024 a 20/11/2024
# Ele ignora o período informado e devolve sempre o mesmo conjunto de
# lançamentos (out/2024 a jan/2025).
# -------------------------------------------
BRADESCO_CLIENT_ID=
BRADESCO_CLIENT_SECRET=
BRADESCO_APP_KEY=
BRADESCO_AGENCIA=
BRADESCO_CONTA=
BRADESCO_CERT_PATH=certs/certificado.crt
BRADESCO_KEY_PATH=certs/chave.key
# Vazio = /auth/server-mtls/v2/token (único endpoint existente no sandbox)
BRADESCO_TOKEN_PATH=
BRADESCO_BASE_URL=https://openapisandbox.prebanco.com.br
BRADESCO_API_URL=https://openapisandbox.prebanco.com.br/v1/fornecimento-extratos-contas
# Deixe vazio para trazer créditos e débitos; use C ou D para filtrar
BRADESCO_FILTRO_SINAL=

# -------------------------------------------
# BANCO SAFRA
# Token: POST {SAFRA_API_URL}/gateway/v1/oauth2/token (grant_type=password)
#
# Cobrança (kit recebido): /gateway/cobrancas/v1/boletos,
#   /gateway/cobrancas/v1/realizarBaixaBoleto e .../RealizarInstrucaoBoleto.
#
# Extrato de conta corrente: produto contratado à parte, fora do kit COB.
# Ajuste SAFRA_EXTRATO_PATH com o caminho liberado pelo banco — o provider já
# trata a resposta e, sem liberação, devolve orientação em vez de erro cru.
#
# Agência/conta abaixo são o padrão quando a conta selecionada na tela não
# informa esses dados; a conta cadastrada sempre tem precedência.
# -------------------------------------------
SAFRA_API_URL=https://api-hml.safranegocios.com.br
SAFRA_CLIENT_ID=
SAFRA_USERNAME=
SAFRA_PASSWORD=
SAFRA_AGENCIA=
SAFRA_CONTA=
SAFRA_EXTRATO_PATH=/gateway/contacorrente/v1/extrato

# -------------------------------------------
# ITAÚ — API Boletos / Extrato Boleto Cobrança
# (collection itau-ep9-api-extrato-v1-externo)
#
# Token:    POST {host}/api/oauth/jwt (grant_type=client_credentials)
# Posições: GET  {ITAU_API_URL}/francesas?agencia&conta&dac&mesReferencia
# Movtos.:  GET  {ITAU_API_URL}/francesas/{francesaId}/movimentacoes?data
#
# ITAU_AMBIENTE=sandbox usa ITAU_SANDBOX_URL; "producao" usa ITAU_BASE_URL
# (produção exige, além disso, private_key_jwt + mTLS).
# Deixe ITAU_API_URL vazio para o ambiente decidir a URL.
# -------------------------------------------
ITAU_AMBIENTE=sandbox
ITAU_API_URL=
ITAU_BASE_URL=https://boleto.api.itau.com/extrato/v1
ITAU_SANDBOX_URL=https://sandbox.devportal.itau.com.br/itau-ep9-api-extrato-v1-externo/v1
ITAU_CLIENT_ID=
ITAU_CLIENT_SECRET=
# Enviada em x-itau-apikey; vazio = usa o ITAU_CLIENT_ID
ITAU_API_KEY=
# A API exige agência (4 díg.) + conta (7 díg.) + DAC (1 díg.).
# O DAC pode vir aqui, no cadastro da conta ("15386-1") ou nos 8 dígitos da conta.
ITAU_AGENCIA=
ITAU_CONTA=
ITAU_DAC=

# -------------------------------------------
# BANCO DO BRASIL — API Extratos v2 (conta corrente PJ)
#
# Token:   POST {BB_TOKEN_URL}/oauth/token
#          (grant_type=client_credentials, scope=extrato-info, Basic)
# Extrato: GET  {BB_EXTRATO_URL}/conta-corrente/agencia/{ag}/conta/{cc}
#
# BB_AMBIENTE=homologacao usa oauth.hm.bb.com.br + extratos.mtls.api.hm...;
# "producao" usa os hosts sem o ".hm". Deixe as URLs vazias para o ambiente
# decidir.
#
# ATENÇÃO: o extrato exige mTLS (o host tem ".mtls." no nome) — baixe o
# certificado no portal do desenvolvedor e informe os caminhos abaixo. O
# token NÃO exige certificado, então a autenticação pode ser validada antes.
#
# Agência e conta vão para a URL SEM dígito verificador e sem zeros à
# esquerda (0297 -> 297); a conversão é automática.
#
# Limites da API: período máximo de 31 dias por consulta e data inicial de no
# máximo 5 anos atrás.
# -------------------------------------------
BB_AMBIENTE=homologacao
BB_CLIENT_ID=
BB_CLIENT_SECRET=
BB_APP_KEY=
# Basic pronto do portal (base64 de client_id:client_secret).
# Vazio = montado a partir do par acima.
BB_BASIC=
# Vazios = definidos por BB_AMBIENTE
BB_TOKEN_URL=
BB_EXTRATO_URL=
# Padrão quando a conta selecionada na tela não informa esses dados
BB_AGENCIA=
BB_CONTA=
# Header x-br-com-bb-ipa-mciteste — só homologação, conforme a massa de teste
BB_MCI_TESTE=
BB_CERT_PATH=
BB_KEY_PATH=

# -------------------------------------------
# PERÍODO PADRÃO DA TELA DE CONCILIAÇÃO
#
# Regra do documento de visão (item 6.1.3.2): bloqueio + 1 até hoje - 1.
# Preencha as duas variáveis abaixo para abrir a tela sempre em uma janela
# fixa; deixe-as vazias para voltar à regra do documento.
#
# Necessário em homologação: o sandbox do Bradesco é um mock e responde 404
# fora do cenário cadastrado. A janela abaixo é a única confirmada em teste
# para a agência 3750 / conta 75557 — é ela que faz "Importar Extrato"
# funcionar. A massa de testes (npm run db:seed) acompanha estas datas.
# -------------------------------------------
NEXT_PUBLIC_PERIODO_INICIO=06/11/2024
NEXT_PUBLIC_PERIODO_FIM=20/11/2024

# ---------------------------------------------------------------------------
# Usuário corrente do módulo (item 6.1.3.1 — permissão de acesso).
# Enquanto não há sessão do Satis, é este nome que a rota confere contra a
# tabela usuario_permissao. INFTEC tem todas as permissões; OPERADOR concilia
# e lança, mas não fecha o período.
# ---------------------------------------------------------------------------
USUARIO_ATUAL=INFTEC

# ---------------------------------------------------------------------------
# Recorta o extrato pelo período informado na tela (item 6.1.3.3).
# Ligado é o comportamento correto em produção. Em homologação, deixe "false":
# o sandbox do Bradesco só ACEITA a janela 06/11/2024-20/11/2024 na consulta,
# mas RESPONDE sempre out/2024 a jan/2025 — com o recorte ligado sobraria um
# único movimento na grade.
#
# Com o extrato gravado no MySQL, a chave age em dois pontos: o que a API
# devolve fora da faixa é gravado do mesmo jeito, e a grade passa a mostrar o
# extrato inteiro da conta em vez de recortar pelo período.
# ---------------------------------------------------------------------------
BANK_FILTRA_PERIODO=true
