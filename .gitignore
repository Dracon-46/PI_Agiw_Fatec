.env
node_modules/
.next/

# ---------------------------------------------------------------------------
# Certificados e chaves privadas — NUNCA versionar, em qualquer diretório
# (as APIs bancárias exigem mTLS; o vazamento da chave compromete o acesso)
# ---------------------------------------------------------------------------
*.pem
*.crt
*.key
*.cer
*.pfx
*.p12
*.jks
!certs/.gitkeep

# A pasta certs/ inteira fica fora do Git: além das chaves mTLS, ela recebe
# manuais e kits enviados pelos bancos, que trazem credenciais de integração.
certs/**
!certs/.gitkeep
!certs/LEIA-ME.txt

# ---------------------------------------------------------------------------
# Credenciais soltas em documentação
# ---------------------------------------------------------------------------
docs/**/credenciais.txt
docs/**/*Welcome*.zip
