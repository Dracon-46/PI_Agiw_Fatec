.env
node_modules/
.next/

# ---------------------------------------------------------------------------
# Certificados e chaves privadas — NUNCA versionar, em qualquer diretório
# (as APIs bancárias exigem mTLS; o vazamento da chave compromete o acesso)
# ---------------------------------------------------------------------------
*.pem
*.crt
*.key
*.cer
*.pfx
*.p12
*.jks
!certs/.gitkeep

# ---------------------------------------------------------------------------
# Credenciais soltas em documentação
# ---------------------------------------------------------------------------
docs/**/credenciais.txt
docs/**/*Welcome*.zip
