# Dependências e build
node_modules/
.next/
out/
coverage/

# Variáveis de ambiente (copie de .env.example)
.env
.env*.local

# Logs e arquivos de sistema
*.log
npm-debug.log*
.DS_Store
Thumbs.db
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# Certificados e chaves privadas: NUNCA versionar, em qualquer diretório.
# As APIs bancárias exigem mTLS e o vazamento da chave compromete o acesso.
# ---------------------------------------------------------------------------
*.pem
*.crt
*.key
*.cer
*.pfx
*.p12
*.jks

# A pasta certs/ recebe as chaves mTLS e os kits enviados pelos bancos
certs/**
!certs/.gitkeep
!certs/LEIA-ME.txt

# Manuais, kits e credenciais dos bancos são confidenciais e ficam fora do Git
docs/**/credenciais*.txt
docs/**/*Welcome*
docs/**/Safra/
